# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# Postgres — matches docker-compose.yml
DATABASE_URL="postgresql://romano:romano@localhost:5432/romano?schema=public"

# API
# Named API_PORT on purpose — a bare PORT would leak into `nx serve web`/`dashboard`
# (Nx loads this file for every task, and Angular's dev server honors PORT).
API_PORT=3000
# Origins allowed to call the API: the customer site and the admin dashboard.
CORS_ORIGINS="http://localhost:4200,http://localhost:4300"

# Auth — generate with: openssl rand -base64 48
JWT_SECRET="change-me-in-any-real-environment"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Receipt uploads land on disk, not in the database.
UPLOAD_DIR="./apps/api/uploads"

# Seeded admin account (pnpm db:seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_FIRST_NAME="مدیر"
ADMIN_LAST_NAME="رومانو"
ADMIN_MOBILE="09120000000"
