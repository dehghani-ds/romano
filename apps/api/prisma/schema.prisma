// Romano — schema.
//
// Two things changed when this moved off Supabase:
//
//   1. `auth.users` + `profiles` collapsed into one `users` table. Sign-in is by
//      username; there is no email column and no synthetic-email mapping.
//   2. Seats, zones and refrigerators are gone. An order is delivered to a
//      company and a team, both snapshotted onto the order so that editing a
//      profile later never rewrites the history of an old order.
//
// An order belongs either to a registered user (`userId`) or to a guest, who is
// identified by an unguessable `guestToken` handed back once at checkout. The
// `orders_owner_ck` constraint in the migration enforces that one of the two is
// always present.

// The v7 generator emits TypeScript, so the client compiles with the rest of
// the app. It lands inside src/ on purpose: tsc then carries it into dist and
// the import path is the same at build time and at run time.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "nodejs"
  moduleFormat    = "cjs"
  importFileExtension = ""
}

// Prisma 7 keeps the connection URL out of the schema — it lives in
// prisma.config.ts for the CLI, and reaches the client through a pg adapter.
datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  admin

  @@map("user_role")
}

enum OrderStatus {
  pending
  in_progress
  done
  cancelled

  @@map("order_status")
}

enum PaymentMethod {
  receipt_upload
  ipg
  cash

  @@map("payment_method")
}

enum PaymentStatus {
  awaiting_receipt
  submitted
  verified
  rejected

  @@map("payment_status")
}

/// What the money went on. Deliberately four broad buckets: an admin should be
/// able to file a receipt without stopping to think, and `other` is a real
/// answer rather than a fallback for a missing category.
enum ExpenseCategory {
  coffee
  supplies
  equipment
  other

  @@map("expense_category")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  mobile       String   @unique
  /// Free text. Everyone is at دیجی‌پی today; the column is here so they need not be.
  companyName  String   @default("دیجی‌پی") @map("company_name")
  teamName     String   @map("team_name")
  role         UserRole @default(customer)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders           Order[]              @relation("OrderCustomer")
  acceptedOrders   Order[]              @relation("OrderAcceptedBy")
  payments         Payment[]            @relation("PaymentCustomer")
  verifiedPayments Payment[]            @relation("PaymentVerifiedBy")
  statusChanges    OrderStatusHistory[]
  expensesPaid     Expense[]            @relation("ExpensePaidBy")
  paymentSettings  PaymentSettings[]    @relation("PaymentSettingsUpdatedBy")

  @@index([role])
  @@map("users")
}

model Product {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("IRR")
  /// What one of this is called: فنجان for coffee, عدد for a cookie.
  unit        String   @default("فنجان")
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id          String @id @default(uuid(7)) @db.Uuid
  orderNumber String @unique @map("order_number")

  /// Null for a guest order.
  userId     String? @map("user_id") @db.Uuid
  /// Set only for a guest order — the bearer secret that lets them read it back.
  guestToken String? @unique @map("guest_token")

  /// Snapshot of who receives the coffee and where, taken at checkout.
  contactName   String @map("contact_name")
  contactMobile String @map("contact_mobile")
  companyName   String @map("company_name")
  teamName      String @map("team_name")

  status       OrderStatus @default(pending)
  deliveryDate DateTime    @map("delivery_date") @db.Date
  totalAmount  Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  currency     String      @default("IRR")
  notes        String?
  adminNote    String?     @map("admin_note")

  acceptedById String?   @map("accepted_by") @db.Uuid
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User?                @relation("OrderCustomer", fields: [userId], references: [id], onDelete: Cascade)
  acceptedBy User?                @relation("OrderAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  items      OrderItem[]
  payment    Payment?
  history    OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([deliveryDate(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([contactMobile])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  /// Snapshot, for the same reason unitPrice is one: renaming a product's unit
  /// later must not silently reword an order that was already placed.
  unit      String   @default("فنجان")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id       String  @id @default(uuid(7)) @db.Uuid
  orderId  String  @unique @map("order_id") @db.Uuid
  /// Null for a guest order, like Order.userId.
  userId   String? @map("user_id") @db.Uuid
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("IRR")

  method PaymentMethod @default(receipt_upload)
  status PaymentStatus @default(awaiting_receipt)

  /// Storage key inside UPLOAD_DIR, never a URL.
  receiptPath String? @map("receipt_path")
  /// The bank's reference for a settled payment — Zibal's `refNumber` for an
  /// online one, and free text for anything reconciled by hand.
  reference   String?

  /// Zibal's payment-session id, held for the whole life of the payment rather
  /// than being overwritten by `reference` on success.
  ///
  /// It is the *only* thing the gateway's callback carries that we can look a
  /// payment up by, and the callback arrives unauthenticated — so this column is
  /// unique, and a session is settled by asking Zibal, never by believing the
  /// query string that pointed us at the row.
  gatewayTrackId     String?   @unique @map("gateway_track_id")
  /// When that session was opened. A fresh session is handed back as-is instead
  /// of minting a second one, so a customer who returns to the tab cannot end up
  /// with two open sessions and pay the one we are no longer watching.
  gatewayRequestedAt DateTime? @map("gateway_requested_at") @db.Timestamptz(6)
  /// The masked card the payer used, exactly as Zibal returns it (`62741****44`).
  /// Kept because it is the one detail a person can match against their own bank
  /// statement; it is not a card number and cannot be paid with.
  gatewayCardNumber  String?   @map("gateway_card_number")

  paidAt       DateTime? @map("paid_at") @db.Timestamptz(6)
  verifiedById String?   @map("verified_by") @db.Uuid
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  rejectReason String?   @map("reject_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User? @relation("PaymentCustomer", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model OrderStatusHistory {
  id          String       @id @default(uuid(7)) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String?      @map("changed_by") @db.Uuid
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt(sort: Desc)])
  @@map("order_status_history")
}

/// How Romano takes money. Exactly one row, edited from the dashboard.
///
/// This used to be split across two places that both required a developer: the
/// card-to-card destination was a constant compiled into both Angular bundles,
/// and the gateway credentials were environment variables. Changing either meant
/// a deploy. They live here so that an admin can change them.
///
/// **`zibalMerchant` is a credential**, and the only one in the database. Two
/// things follow, and they are enforced in `PaymentSettingsService` rather than
/// here because the database cannot enforce either: it is never returned to any
/// client — reads answer with a mask and a boolean — and it is never logged.
model PaymentSettings {
  /// Singleton. `1` is the only legal value, and the CHECK in the migration says
  /// so: settings that could exist twice are settings that can disagree.
  id Int @id @default(1)

  // --- Card to card ---------------------------------------------------------
  // Not secret: every customer is shown these in order to pay.

  /// Always available as the fallback, because a bank transfer works on a day
  /// the gateway does not.
  cardToCardEnabled Boolean @default(true) @map("card_to_card_enabled")
  cardHolder        String  @map("card_holder")
  /// Stored bare, exactly as a banking app wants it pasted. Grouping is display.
  cardNumber        String  @map("card_number")

  // --- Zibal IPG ------------------------------------------------------------

  /// The admin's switch. Online payment is offered only when this is on *and*
  /// the merchant and callback URL are both filled in — a half-configured
  /// gateway must not put a button on the page that fails at the bank.
  onlineEnabled    Boolean @default(false) @map("online_enabled")
  /// Secret. Authenticates Romano to Zibal on every call.
  zibalMerchant    String? @map("zibal_merchant")
  zibalBaseUrl     String  @default("https://gateway.zibal.ir") @map("zibal_base_url")
  /// Where Zibal returns the payer's browser — the public API origin plus
  /// `/api/payments/callback`.
  zibalCallbackUrl String? @map("zibal_callback_url")
  /// Where the API forwards the payer once the payment is settled.
  webBaseUrl       String? @map("web_base_url")

  /// Who last touched this. The one credential in the database is worth knowing
  /// the last editor of; SetNull because a departed admin must not lock the row.
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedBy User? @relation("PaymentSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("payment_settings")
}

/// What Romano costs to run: a bag of beans, a sleeve of cups, a new grinder.
///
/// This is a shared ledger, not a per-admin one. Every admin sees every row and
/// may correct any of them, because the point is one honest book rather than
/// several private ones. What the book does *not* do is split anything: an
/// expense has exactly one payer, and who ultimately owes whom is settled
/// outside this table.
///
/// Nothing here touches an order. An expense is money going out; a payment is
/// money coming in, and the two are never netted against each other.
model Expense {
  id       String          @id @default(uuid(7)) @db.Uuid
  title    String
  amount   Decimal         @db.Decimal(12, 2)
  currency String          @default("IRR")
  category ExpenseCategory @default(other)

  /// The Tehran day the money was spent — a day, not an instant, because a
  /// receipt is dated and never timed.
  spentAt DateTime @map("spent_at") @db.Date
  note    String?

  /// The admin who actually paid — not necessarily the one who typed it in.
  /// One admin records what a colleague bought often enough that the two must
  /// not be conflated, and fixing the payer afterwards is an ordinary edit.
  paidById String @map("paid_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Restrict, not SetNull: the column is NOT NULL, and an expense whose payer
  /// vanished is a hole in the accounts rather than a tidy null.
  paidBy User @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  @@index([spentAt(sort: Desc)])
  @@index([paidById])
  @@index([category])
  @@map("expenses")
}
